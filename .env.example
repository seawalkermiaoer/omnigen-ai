# ── DashScope ──────────────────────────────────────────────────
token=sk-xxxxxxxxxxxxxxxx

# ── OSS (Alibaba Cloud Object Storage Service) ────────────────
# RAM user AccessKey (required)
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# OSS bucket name (default: trans-ai-cn)
OSS_BUCKET=trans-ai-cn
# OSS region identifier (default: oss-cn-chengdu)
OSS_REGION=oss-cn-chengdu
# RAM role ARN for STS temporary credentials (optional)
# If set → STS mode with AssumeRole. If empty → direct AK/SK mode.
OSS_ROLE_ARN=
# STS token lifetime in seconds (900-3600, default 3600, only used in STS mode)
OSS_TOKEN_EXPIRE_SECONDS=3600